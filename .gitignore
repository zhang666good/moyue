# 图标生成器的中间产物，可由 flutter test test/icon_gen.dart 重建
/assets/icon/_ico_check/
# 裸 RGBA（5.4MB，仅供 tool/make_ico.py 免解 PNG 组装 .ico，用完即可丢弃）
/assets/icon/*.rgba

